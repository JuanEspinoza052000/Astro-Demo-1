---
// src/components/TestimonialCarousel.astro

const testimonials = [
  {
    name: "Carlos Rodríguez",
    quote: "Este servicio fue excelente. ¡Muy recomendado!",
    avatar: "/avatars/carlos.jpg",
  },
  {
    name: "Ana Pérez",
    quote: "Un equipo profesional y siempre atentos.",
    avatar: "/avatars/ana.jpg",
  },
  {
    name: "Luis Gómez",
    quote: "Me ayudaron con mi proyecto desde el inicio hasta el final.",
    avatar: "/avatars/luis.jpg",
  },
];
---
<div class="relative max-w-xl mx-auto overflow-hidden bg-white rounded-2xl shadow-md">
  <div 
    class="flex transition-transform duration-500 ease-in-out"
    id="carousel"
    style="transform: translateX(0%)"
  >
    {testimonials.map((testimonial) => (
      <div class="w-full flex-shrink-0 p-6 text-center">
        <img src={testimonial.avatar} alt={testimonial.name} class="mx-auto w-16 h-16 rounded-full mb-4 object-cover" />
        <p class="text-lg italic text-gray-700 mb-2">"{testimonial.quote}"</p>
        <h3 class="font-bold text-gray-900">{testimonial.name}</h3>
      </div>
    ))}
  </div>

  <!-- Botones -->
  <div class="absolute inset-0 flex justify-between items-center px-4">
    <button 
      class="bg-white/70 hover:bg-white p-2 rounded-full shadow"
      onclick="prevSlide()"
      aria-label="Anterior"
    >
      ⬅
    </button>
    <button 
      class="bg-white/70 hover:bg-white p-2 rounded-full shadow"
      onclick="nextSlide()"
      aria-label="Siguiente"
    >
      ➡
    </button>
  </div>
</div>

<script is:inline>
  let index = 0;
  const total = 3;

  function updateCarousel() {
    const carousel = document.getElementById("carousel");
    if (carousel) {
      carousel.style.transform = `translateX(-${index * 100}%)`;
    }
  }

  function nextSlide() {
    index = (index + 1) % total;
    updateCarousel();
  }

  function prevSlide() {
    index = (index - 1 + total) % total;
    updateCarousel();
  }

  // (Opcional) Auto slide cada 5 segundos
  setInterval(nextSlide, 5000);
</script>
