---
const { 
  name = "Cliente Satisfecho",
  content = "Excelente servicio, muy profesional.",
  rating = 5 
} = Astro.props;
---

<div class="bg-gray-700 p-6 rounded-lg h-full">
  <div class="flex mb-4">
    {[1, 2, 3, 4, 5].map((star) => (
      <span class={`text-xl ${star <= rating ? 'text-amber-500' : 'text-gray-500'}`}>★</span>
    ))}
  </div>
  <p class="text-gray-300 mb-4 italic">"{content}"</p>
  <div class="border-t border-gray-600 pt-4">
    <p class="font-bold text-white">{name}</p>
  </div>
</div>