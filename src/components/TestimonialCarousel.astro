---
// src/components/TestimonialCarousel.astro

interface Testimonial {
  name: string;
  quote: string;
  avatar: string;
  role: string;
}

const testimonials: Testimonial[] = [
  { 
    name: "Carlos Rodríguez", 
    quote: "Este servicio fue excelente. ¡Muy recomendado!", 
    avatar: "/avatars/carlos.jpg",
    role: "CEO, TechSolutions"
  },
  { 
    name: "Ana Pérez", 
    quote: "Un equipo profesional y siempre atentos.", 
    avatar: "/avatars/ana.jpg",
    role: "Directora de Marketing"
  },
  { 
    name: "Luis Gómez", 
    quote: "Me ayudaron con mi proyecto desde el inicio hasta el final.", 
    avatar: "/avatars/luis.jpg",
    role: "Emprendedor"
  },
  { 
    name: "Maria Soto", 
    quote: "Increíble calidad de atención al cliente.", 
    avatar: "/avatars/maria.jpg",
    role: "Gerente de Proyectos"
  },
  { 
    name: "Pedro Álvarez", 
    quote: "Los recomiendo totalmente para cualquier proyecto.", 
    avatar: "/avatars/pedro.jpg",
    role: "CTO, Innovatech"
  },
  { 
    name: "Lucía Fernández", 
    quote: "Rápidos, eficientes y muy atentos.", 
    avatar: "/avatars/lucia.jpg",
    role: "Diseñadora UX/UI"
  },
  { 
    name: "Jorge Herrera", 
    quote: "Sin duda trabajaré con ellos otra vez.", 
    avatar: "/avatars/jorge.jpg",
    role: "Fundador, StartUpX"
  },
  { 
    name: "Sofía Morales", 
    quote: "¡Un 10 de 10 en todo momento!", 
    avatar: "/avatars/sofia.jpg",
    role: "Directora Comercial"
  },
  { 
    name: "Andrés Vargas", 
    quote: "Servicio impecable desde el primer contacto.", 
    avatar: "/avatars/andres.jpg",
    role: "Consultor TI"
  },
];

// Función con tipos explícitos
function groupTestimonials(arr: Testimonial[], size: number = 2): Testimonial[][] {
  const groups: Testimonial[][] = [];
  for (let i = 0; i < arr.length; i += size) {
    groups.push(arr.slice(i, i + size));
  }
  return groups;
}

const groupedTestimonials = groupTestimonials(testimonials);
const totalSlides = groupedTestimonials.length;
const autoplayInterval = 8000; // 8 segundos
---

<div class="relative max-w-6xl mx-auto overflow-hidden bg-white rounded-2xl shadow-lg">
  <!-- Indicadores -->
  <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2 z-10">
    {groupedTestimonials.map((_, i) => (
      <button
        onclick={`goToSlide(${i})`}
        class={`w-3 h-3 rounded-full transition-all ${i === 0 ? 'bg-blue-600 w-6' : 'bg-gray-300'}`}
        aria-label={`Ir al testimonio ${i + 1}`}
      />
    ))}
  </div>

  <div 
    class="flex transition-transform duration-500 ease-in-out"
    id="carousel"
    style="transform: translateX(0%)"
  >
    {groupedTestimonials.map((group) => (
      <div class="min-w-full flex-shrink-0 flex flex-col md:flex-row justify-center gap-6 p-8">
        {group.map((testimonial: Testimonial) => (
          <div class="w-full md:w-1/2 bg-gray-50 p-8 rounded-xl shadow-md text-center hover:shadow-lg transition-shadow">
            <img 
              src={testimonial.avatar} 
              alt={testimonial.name} 
              class="mx-auto w-20 h-20 rounded-full mb-6 object-cover border-4 border-white shadow-md" 
              loading="lazy"
            />
            <p class="text-xl italic text-gray-700 mb-4 leading-relaxed">"{testimonial.quote}"</p>
            <h3 class="font-bold text-gray-900 text-lg">{testimonial.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{testimonial.role}</p>
            <div class="flex justify-center mt-4 text-yellow-400">
              {[1, 2, 3, 4, 5].map(() => (
                <span class="text-xl">★</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>

  <!-- Botones de navegación -->
  <div class="absolute inset-0 flex justify-between items-center px-4 pointer-events-none">
    <button 
      class="bg-white/90 hover:bg-white p-3 rounded-full shadow-lg pointer-events-auto transition-transform hover:scale-110"
      onclick="prevSlide()"
      aria-label="Testimonio anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button 
      class="bg-white/90 hover:bg-white p-3 rounded-full shadow-lg pointer-events-auto transition-transform hover:scale-110"
      onclick="nextSlide()"
      aria-label="Siguiente testimonio"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  let index = 0;
  const total = {totalSlides};
  let autoplay = setInterval(nextSlide, {autoplayInterval});

  function updateCarousel() {
    const carousel = document.getElementById("carousel");
    if (carousel) {
      carousel.style.transform = `translateX(-${index * 100}%)`;
    }
    
    // Actualizar indicadores
    document.querySelectorAll('[aria-label^="Ir al testimonio"]').forEach((btn, i) => {
      btn.classList.toggle('bg-blue-600', i === index);
      btn.classList.toggle('bg-gray-300', i !== index);
      btn.classList.toggle('w-6', i === index);
      btn.classList.toggle('w-3', i !== index);
    });
    
    // Reiniciar autoplay
    resetAutoplay();
  }

  function nextSlide() {
    index = (index + 1) % total;
    updateCarousel();
  }

  function prevSlide() {
    index = (index - 1 + total) % total;
    updateCarousel();
  }
  
  function goToSlide(i) {
    index = i;
    updateCarousel();
  }
  
  function resetAutoplay() {
    clearInterval(autoplay);
    autoplay = setInterval(nextSlide, {autoplayInterval});
  }
  
  // Pausar autoplay al interactuar
  document.getElementById('carousel')?.addEventListener('mouseenter', () => {
    clearInterval(autoplay);
  });
  
  document.getElementById('carousel')?.addEventListener('mouseleave', () => {
    resetAutoplay();
  });
</script>