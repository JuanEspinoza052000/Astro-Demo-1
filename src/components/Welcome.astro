---
import "../styles/global.css";
---

<nav class="bg-white shadow-lg rounded-2xl mx-auto mt-4 w-[90%] px-6 py-2">
  <div class="max-w-7xl mx-auto flex justify-between items-center h-16">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="text-2xl font-bold text-blue-600">MiLogo</a>
    </div>

    <!-- Navegación Desktop -->
    <div class="hidden md:flex items-center space-x-6">
      <button onclick="location.href='/'" class="text-gray-700 hover:text-blue-600 transition">Inicio</button>

      <!-- Dropdown -->
      <div class="relative group">
        <button class="text-gray-700 hover:text-blue-600 transition">Servicios</button>
        <div class="absolute left-0 hidden group-hover:flex flex-col bg-white shadow-md mt-2 rounded-md z-10 min-w-[160px]">
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 text-left w-full">Web</button>
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 text-left w-full">Apps</button>
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 text-left w-full">Marketing</button>
        </div>
      </div>

      <button onclick="location.href='/about'" class="text-gray-700 hover:text-blue-600 transition">Contacto</button>
      <button onclick="location.href='/Login'" class="text-gray-700 hover:text-blue-600 transition">Cuenta</button>
      <button onclick="location.href='#'" class="text-gray-700 hover:text-blue-600 transition">Comprar</button>
    </div>

    <!-- Botón hamburguesa -->
    <div class="md:hidden flex items-center">
      <button id="menu-toggle" class="text-gray-700 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden flex flex-col gap-2 mt-3 px-2">
    <button onclick="location.href='/'" class="text-gray-700 hover:text-blue-600">Inicio</button>
    <details class="group">
      <summary class="cursor-pointer text-gray-700 hover:text-blue-600">Servicios</summary>
      <div class="pl-4 mt-1 space-y-1">
        <button onclick="location.href='#'" class="text-sm text-gray-700 hover:text-blue-600 block">Web</button>
        <button onclick="location.href='#'" class="text-sm text-gray-700 hover:text-blue-600 block">Apps</button>
        <button onclick="location.href='#'" class="text-sm text-gray-700 hover:text-blue-600 block">Marketing</button>
      </div>
    </details>
    <button onclick="location.href='/about'" class="text-gray-700 hover:text-blue-600">Contacto</button>
    <button onclick="location.href='/Login'" class="text-gray-700 hover:text-blue-600">Cuenta</button>
    <button onclick="location.href='#'" class="text-gray-700 hover:text-blue-600">Comprar</button>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
