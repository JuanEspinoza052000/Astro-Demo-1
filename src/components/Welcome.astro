---
import "../styles/global.css";
---
<nav class="bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold text-blue-600">MiLogo</a>
      </div>

      <!-- Navegación Desktop -->
      <div class="hidden md:flex items-center space-x-4">
        <button onclick="location.href='/'" class="text-gray-700 hover:text-blue-500">Inicio</button>

        <!-- Dropdown con button -->
        <div class="relative group">
          <button class="text-gray-700 hover:text-blue-500">Servicios</button>
          <div class="absolute left-0 hidden group-hover:block bg-white shadow-md mt-2 rounded-md z-10 min-w-[150px]">
            <button onclick="location.href='#'" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Web</button>
            <button onclick="location.href='#'" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Apps</button>
            <button onclick="location.href='#'" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Marketing</button>
          </div>
        </div>

        <button onclick="location.href='/about'" class="text-gray-700 hover:text-blue-500">Contacto</button>
        <button onclick="location.href='/Login'" class="text-gray-700 hover:text-blue-500">Cuenta</button>
        <button onclick="location.href='#'" class="text-gray-700 hover:text-blue-500">Comprar</button>
      </div>

      <!-- Botón hamburguesa -->
      <div class="md:hidden flex items-center">
        <button id="menu-toggle" class="text-gray-700 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 space-y-2">
    <button onclick="location.href='/'" class="block text-gray-700 hover:text-blue-500">Inicio</button>
    <details class="group">
      <summary class="cursor-pointer text-gray-700 hover:text-blue-500">Servicios</summary>
      <div class="pl-4 mt-1 space-y-1">
        <button onclick="location.href='#'" class="block text-sm text-gray-700 hover:text-blue-500">Web</button>
        <button onclick="location.href='#'" class="block text-sm text-gray-700 hover:text-blue-500">Apps</button>
        <button onclick="location.href='#'" class="block text-sm text-gray-700 hover:text-blue-500">Marketing</button>
      </div>
    </details>
    <button onclick="location.href='/about'" class="block text-gray-700 hover:text-blue-500">Contacto</button>
    <button onclick="location.href='/Login'" class="block text-gray-700 hover:text-blue-500">Cuenta</button>
    <button onclick="location.href='#'" class="block text-gray-700 hover:text-blue-500">Comprar</button>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
