<nav class="bg-linear-to-r  from-gray-800 via-blue-700 to-gray-900 backdrop-blur-sm  shadow-lg rounded-2xl mx-auto mt-4 w-full px-6 py-4 fixed">

  <div class="max-w-7xl mx-auto flex justify-between items-center h-16">
    <!-- Logo -->
    <div class="flex items-center">
     
      <img src="/images/logo.png" alt="Logo" class="w-12 h-12 ml-2 rounded-full">
    </div>

    <!-- Navegación Desktop -->
    <div class="hidden md:flex items-center space-x-8">
      <button onclick="location.href='/'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Inicio</button>

      <!-- Dropdown -->
      <div class="relative group">
        <button class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Servicios</button>
        <div class="absolute left-0 hidden group-hover:flex flex-col bg-white shadow-lg mt-2 rounded-md z-10 min-w-[160px]">
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-900 hover:bg-gray-100 text-left w-full rounded-md">Web</button>
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-900 hover:bg-gray-100 text-left w-full rounded-md">Apps</button>
          <button onclick="location.href='#'" class="px-4 py-2 text-sm text-gray-900 hover:bg-gray-100 text-left w-full rounded-md">Marketing</button>
        </div>
      </div> 

      <button onclick="location.href='/About'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Contacto</button>
      <button onclick="location.href='/Login'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Cuenta</button>
      <button onclick="location.href='/Product'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Comprar</button>
      <button onclick="location.href='/Appointment'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Agendar</button>
      <button onclick="location.href='/Admin'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Admin</button>
    </div>

    <!-- Botón hamburguesa -->
    <div class="md:hidden flex items-center">
      <button id="menu-toggle" class="text-gray-300 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="md:hidden flex flex-col gap-2 mt-3 px-2 hidden">
    <button onclick="location.href='/'" class="text-gray-800 hover:text-blue-600 px-4 py-2">Inicio</button>
      <button onclick="location.href='/About'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Contacto</button>
      <button onclick="location.href='/Login'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Cuenta</button>
      <button onclick="location.href='/Product'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Comprar</button>
      <button onclick="location.href='/Appointment'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Agendar</button>
      <button onclick="location.href='/Admin'" class="text-gray-300 hover:text-blue-600 transition-all duration-300 px-3 py-2 rounded-lg">Admin</button>
    </div>
</nav>

<script is:inline>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
