---
import gsap from 'gsap';

---




<div class="min-h-screen bg-gradient-to-tl from-gray-300 via-gray-500 to-gray-700 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">







    <!-- Encabezado con logo/icono de barbería -->
    <div class="text-center mb-10">
      <div class="mx-auto h-20 w-20 bg-amber-600 rounded-full flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9z" clip-rule="evenodd" />
        </svg>
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl font-serif">AGENDA TU CITA</h2>
      <p class="mt-4 text-lg text-gray-900">"La mejor experiencia de barbería en la ciudad"</p>
    </div>








    <!-- Formulario con estilo vintage/masculino -->
    <div class="bg-gray-700 shadow-xl rounded-lg overflow-hidden border border-black">
      <div class="bg-gray-900 px-6 py-4">
        <h3 class="text-xl font-bold text-white font-serif text-center">Datos de la Reserva</h3>
      </div>
      
      <form class="p-6 sm:p-8">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">






          <!-- Nombre -->
          <div >
            <label for="name" class="block text-sm font-medium text-white  mb-1">Nombre Completo</label>
            <div class="relative">
              <input type="text" id="name" class="w-full px-4 py-2 border bg-gray-800 border-gray-300 rounded-md focus:ring-amber-500 focus:border-amber-500" placeholder="Juan Pérez">
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            </div>
          </div>
          






          <!-- Teléfono -->
          <div>
            <label for="phone" class="block text-sm font-medium text-white mb-1">Teléfono</label>
            <input type="tel" id="phone" class="w-full px-4 py-2 border bg-gray-800 border-gray-300 rounded-md focus:ring-amber-500 focus:border-amber-500" placeholder="8888-8888">
          </div>
          







          <!-- Servicio -->
          <div class="sm:col-span-2">
            <label for="service" class="block text-sm font-medium text-white mb-1">Servicio</label>
            <div class="relative">
              <select id="service" class="appearance-none w-full px-4 py-2 border border-gray-600 rounded-md focus:ring-amber-500 focus:border-amber-500 bg-gray-800">
                <option selected disabled>Seleccione un servicio</option>
                <option>Corte Clásico</option>
                <option>Corte + Afeitado</option>
                <option>Corte Premium (Tijera)</option>
                <option>Afeitado de Barba</option>
                <option>Tratamiento Capilar</option>
                <option>Servicio Completo</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg class="h-5 w-5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
          







          <!-- Barbero -->
          <div>
            <label for="barber" class="block text-sm font-medium text-white mb-1">Preferencia de Barbero</label>
            <div class="relative">
              <select id="barber" class="appearance-none w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-amber-500 focus:border-amber-500 bg-gray-800">
                <option selected>Cualquier barbero</option>
                <option>Carlos (Experto en fades)</option>
                <option>Miguel (Especialista en barbas)</option>
                <option>Andrés (Cortes clásicos)</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
          






          <!-- Fecha y Hora -->
          <div>
            <label for="datetime" class="block text-sm font-medium text-gray-700 mb-1">Fecha y Hora</label>
            <input type="datetime-local" id="datetime" class="w-full px-4 py-2 border bg-gray-800 border-gray-300 rounded-md focus:ring-amber-500 focus:border-amber-500">
          </div>





          
          <!-- Notas -->

          <div class="sm:col-span-2 bg-gray-500">
           
            <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-amber-500 focus:border-amber-500" placeholder="Ej: Quiero un fade bajo con diseño en la parte izquierda..."></textarea>
          </div>
          






          <!-- Términos -->
          <div class="sm:col-span-2 flex items-start">
            <div class="flex items-center h-5">
              <input id="terms" type="checkbox" class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded">
            </div>
            <div class="ml-3 text-sm">
              <label for="terms" class="font-medium text-gray-700">Acepto los </label>
              <a href="#" class="text-amber-600 hover:text-amber-500">términos y condiciones</a>
              <p class="text-gray-500 mt-1">Recibirás un SMS de confirmación</p>
            </div>
          </div>
        </div>
        






        <!-- Botón de enviar -->
        <div class="mt-8">
          <button type="submit" class="w-full bg-gray-500 hover:bg-gray-900 text-white font-bold py-3 px-4 rounded-md transition duration-300 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
            </svg>
            CONFIRMAR CITA
          </button>
          <button class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-green-400 to-blue-600 group-hover:from-green-400 group-hover:to-blue-600 hover:text-white dark:text-white focus:ring-4 focus:outline-none focus:ring-green-200 dark:focus:ring-green-800">
            <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-transparent group-hover:dark:bg-transparent">
            CONFIRMAR CITA
            </span>
            </button>
        </div>
      </form>
    </div>
    






    <!-- Información adicional -->
    <div class="mt-8 text-center text-sm text-gray-500">
      <p>Horario: Lunes a Sábado 9:00 AM - 7:00 PM</p>
      <p class="mt-1">Dirección: Av. Central, San José, Costa Rica</p>
      <p class="mt-4 font-medium text-amber-700">¡Llega 10 minutos antes de tu cita!</p>
    </div>
  </div>
</div>