---
const images = [
  "https://images.unsplash.com/photo-1621607512214-682974801650?auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1621607512274-9a5dc5c5ee1f?auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1621607512306-0f2a5ee4d803?auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1621607512229-4d2f64c35353?auto=format&fit=crop&w=400&q=80"
];
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {images.map((image) => (
    <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
      <img 
        src={image} 
        alt="Trabajo de barbería" 
        class="w-full h-full object-cover hover:scale-105 transition duration-500"
      />
    </div>
  ))}
</div>