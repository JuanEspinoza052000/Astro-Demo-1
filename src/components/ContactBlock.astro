---
const { variant = "light" } = Astro.props;
---

<div class={`p-8 rounded-lg ${
  variant === 'light' ? 'bg-gray-800' : 'bg-gray-900'
}`}>
  <h3 class="text-xl font-bold mb-6 text-amber-500">Información de Contacto</h3>
  
  <div class="space-y-4">
    <div class="flex items-start">
      <span class="text-amber-500 mr-3 mt-1">📍</span>
      <p>Calle Principal 123, Ciudad</p>
    </div>
    
    <div class="flex items-start">
      <span class="text-amber-500 mr-3 mt-1">📞</span>
      <p>+1 234 567 890</p>
    </div>
    
    <div class="flex items-start">
      <span class="text-amber-500 mr-3 mt-1">✉️</span>
      <p>contacto@barberia.com</p>
    </div>
  </div>
</div>