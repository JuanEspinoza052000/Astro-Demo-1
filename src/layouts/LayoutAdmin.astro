---
import "../styles/global.css";
import { ViewTransitions } from 'astro:transitions';
import ScrollButton from "../components/ScrollButton.astro";
import Sidebar from "../components/AdminComp/Sidebar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Barber Demo</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <ViewTransitions />
  </head>
  <body class="bg-gradient-to-tl from-gray-300 via-gray-500 to-gray-700 text-white opacity-100 transition-opacity duration-3000 ease-in-out">
	<div class="page-wrapper">
	 
	  <slot />

	</div>
  
	<script>
	  document.body.classList.remove('opacity-100');
	  window.addEventListener('astro:page-load', () => {
		document.body.classList.add('opacity-100');
	  });



    
	</script>
    <Sidebar client:load />
  <script src="//unpkg.com/alpinejs" defer></script>
  <ScrollButton />
  </body>
  
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
