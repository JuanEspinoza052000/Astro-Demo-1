---
// Importa tus componentes y layout
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import AppointmentComp from "../components/appointmentComp.astro";
---

<Layout>
   
    <AppointmentComp />
  


    <!-- Asegúrate de que el script esté correctamente incluido -->
    <script type="module">
        document.addEventListener("DOMContentLoaded", function () {
            const button = document.getElementById("Agendar");
            if (button) {
                button.addEventListener("click", function (event) {
                    event.preventDefault(); // evita que el formulario se envíe
                    alert("¡Tu cita ha sido agendada con éxito!");
                });
            }
        });
    </script>
</Layout>
